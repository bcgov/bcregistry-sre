# =============================================================================
# .env.test — Local testing configuration (Docker Compose PostgreSQL)
# =============================================================================
# Usage:
#   docker compose up -d
#   set -a; source .env.test; set +a; ./scripts/entrypoint.sh
# =============================================================================

# Execution mode
MODE=tables_only
TABLE_LIST="businesses"
FK_DEPTH=-1

# Source database (local Docker)
SOURCE_DB_USER=loader
SOURCE_DB=business
SOURCE_SCHEMA=public
SOURCE_PGHOST=127.0.0.1
SOURCE_PGPORT=5432

# Target database (local Docker)
TARGET_DB_USER=loader
TARGET_DB=business
TARGET_SCHEMA=public
TARGET_PGHOST=127.0.0.1
TARGET_PGPORT=5434

# Local password (real password, not IAM sentinel)
DB_PASSWORD=testpass

# Owner role
DB_OWNER_ROLE=loader

# Disable Cloud SQL Proxy (local Docker)
USE_PROXY=false

# GCS not needed for local testing
GCS_BUCKET=
SKIP_EXISTING_DUMP=false

# Masking / seeding
MASKING_ENABLED=false
SEED_DATA_ENABLED=true
SEED_FROM_TARGET_TABLES="office_types"
SEED_CONFLICT_MODE=overwrite

# Safety
ALLOW_PROD_TARGET=false
FAIL_FAST=true
LOG_LEVEL=INFO
