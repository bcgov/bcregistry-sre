# =============================================================================
# .env.example — Environment variable template for GCP Sandbox Database Loader
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control (it is in .gitignore).
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   set -a; source .env; set +a; ./scripts/entrypoint.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Execution Mode
# -----------------------------------------------------------------------------
# full_refresh    : Dump and restore entire database (schema + data)
# schema_only     : Dump and restore schema structure only (no row data)
# tables_only     : Dump and restore specific tables only (set TABLE_LIST below)
# sync_only       : Skip dump/restore; only sync types/functions/extensions (set SYNC_* flags below)
# wipe            : Drop and recreate the target database — clean empty slate for testing
# reload          : Re-download existing dump from GCS and restore (no new dump); defaults to latest dump in bucket
# drop_tables     : Drop specific tables only (set TABLE_LIST); skips dump/restore/post-processing
# truncate_tables : Truncate specific tables only (set TABLE_LIST); skips dump/restore/post-processing
# post_process    : Mask + seed + grants only; requires existing tables; skips dump/restore
MODE=full_refresh

# Comma-separated list of tables (required when MODE=tables_only, drop_tables, or truncate_tables)
# Example: TABLE_LIST="users,orders,products"
TABLE_LIST=""

# FK dependency depth (tables_only mode):
#   0  : Strip all FOREIGN KEY constraints from the restore (only TABLE_LIST tables are dumped)
#   -1 : Resolve full transitive FK chain — auto-detect and include all FK-referenced tables (default)
#       FK-referenced tables are also dropped before restore (alongside TABLE_LIST)
#       to prevent "already exists" errors and data duplication on re-runs.
#       Cycles in FK graphs are handled safely via the recursive CTE (NOT IN visited).
FK_DEPTH=-1

# -----------------------------------------------------------------------------
# Object Sync Flags (used with tables_only or sync_only)
# -----------------------------------------------------------------------------
# Opt-in flags to sync supporting objects from source to target.
# Set any to true to enable.
#
# Sync custom types (enums, domains):
#   tables_only: restricts to types used by the listed tables
#   sync_only:   syncs ALL custom types
SYNC_TYPES=false

# Sync sequences (CREATE SEQUENCE IF NOT EXISTS):
SYNC_SEQUENCES=false

# Sync functions (CREATE OR REPLACE FUNCTION):
SYNC_FUNCTIONS=false

# Sync extensions (CREATE EXTENSION IF NOT EXISTS):
SYNC_EXTENSIONS=false

# -----------------------------------------------------------------------------
# Source Database (Production)
# -----------------------------------------------------------------------------
SOURCE_PROJECT=prod-project-id
SOURCE_REGION=northamerica-northeast1
SOURCE_INSTANCE=prod-cloudsql-instance
SOURCE_DB=production_database
SOURCE_SCHEMA=public

# IAM database user for the source (format: service-account@project.iam)
# The Cloud SQL Proxy --auto-iam-authn flag handles authentication automatically.
# No password is needed or used for IAM users.
SOURCE_DB_USER=sa-db-reader@prod-project-id.iam

# Local override for source connection (used with Docker or external PG).
# When set, these override the proxy port for source connections.
# SOURCE_PGHOST=127.0.0.1
# SOURCE_PGPORT=5432

# -----------------------------------------------------------------------------
# Target Database (Sandbox)
# -----------------------------------------------------------------------------
TARGET_PROJECT=sandbox-project-id
TARGET_REGION=northamerica-northeast1
TARGET_INSTANCE=sandbox-cloudsql-instance
TARGET_DB=sandbox_database
TARGET_SCHEMA=public

# IAM database user for the target (must have cloudsqlsuperuser or equivalent in Cloud SQL)
# This user performs all operations: DROP DATABASE, CREATE DATABASE, restore, mask
TARGET_DB_USER=sa-db-writer@sandbox-project-id.iam

# Local override for target connection (used with Docker or external PG).
# When set, these override the proxy port for target connections.
# TARGET_PGHOST=127.0.0.1
# TARGET_PGPORT=5434

# Non-login role that owns all database objects (schema, tables, sequences, functions).
# Objects restored by TARGET_DB_USER are reassigned to this role after restore.
# This role is created (if not exists) in the sandbox before restore.
DB_OWNER_ROLE=app_owner

# -----------------------------------------------------------------------------
# GCS Configuration
# -----------------------------------------------------------------------------
# Bucket for dump storage and script retrieval.
# Expected structure:
#   gs://<GCS_BUCKET>/dumps/         — pg_dump output files
#   gs://<GCS_BUCKET>/scripts/       — mask.sql
#   gs://<GCS_BUCKET>/scripts/seeds/ — seed SQL files (01_users.sql, etc.)
GCS_BUCKET=my-project-db-dumps

# -----------------------------------------------------------------------------
# Optional Features
# -----------------------------------------------------------------------------
# Set to true to apply data masking after restore (requires anon extension)
MASKING_ENABLED=false

# Path to masking rules YAML (local file path OR gs://... GCS path)
# MASKING_YAML=/scripts/masking.yaml
# MASKING_YAML=gs://my-project-db-dumps/scripts/masking.yaml

# Set to true to inject synthetic data from GCS seeds after masking
SEED_DATA_ENABLED=false

# Database password for local Docker PostgreSQL connections.
# In Cloud SQL mode, IAM auth is used and this value is ignored.
# When USE_PROXY=false, this is the actual password for the PG containers.
DB_PASSWORD=your_local_pg_password_here

# Comma-separated table names to backup from TARGET before restore and upsert
# back after (only for tables_only and reload modes). Requires SEED_DATA_ENABLED=true.
# Useful for preserving sandbox-specific rows alongside restored prod data.
# Example: SEED_FROM_TARGET_TABLES="office_types,corp_types,jurisdictions"
SEED_FROM_TARGET_TABLES=""

# Conflict resolution when upserting target backup rows after restore:
#   skip      : keep restored prod row on conflict (ON CONFLICT DO NOTHING — default)
#   overwrite : seed row wins on conflict (ON CONFLICT DO UPDATE via PK introspection)
SEED_CONFLICT_MODE=skip

# -----------------------------------------------------------------------------
# Operational Settings
# -----------------------------------------------------------------------------
# Skip dump phase if today's dump already exists in GCS (idempotency)
SKIP_EXISTING_DUMP=false

# Fail immediately on any error (recommended for production)
FAIL_FAST=true

# Log verbosity: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Proxy Settings
# -----------------------------------------------------------------------------
# Set to false to skip Cloud SQL Proxy startup (required when connecting to
# local Docker PostgreSQL or any non-Cloud SQL database).
# When false, SOURCE_DB_USER authenticates with DB_PASSWORD instead of IAM.
# GCS_BUCKET is also optional when USE_PROXY=false.
USE_PROXY=true

# -----------------------------------------------------------------------------
# Safety Overrides
# -----------------------------------------------------------------------------
# By default, the loader refuses to write to any target whose project/instance/db
# name contains the string "prod". Set this to true ONLY if you are certain
# your target is safe (e.g., a prod-named instance used for staging).
ALLOW_PROD_TARGET=false
